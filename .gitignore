# Secrets — never commit
.env
.env.*
!.env.example
**/.env
**/.env.*

# Provider tokens / vault material
*.token
*.key
secrets/

# Local database (contains financial data)
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
backend/data/*.sqlite
backend/data/*.sqlite-shm
backend/data/*.sqlite-wal

# QA screenshots (regenerated by qa-playwright.cjs)
shots/

# Node
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db

# Agent verification scratch dumps (may contain financial data)
scratch_*.json

# Claude Code user settings (local permissions, not shared)
.claude/settings.json
.claude/settings.local.json
